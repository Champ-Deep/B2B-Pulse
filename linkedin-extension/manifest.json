{
  "manifest_version": 3,
  "name": "ChampMail Connector (dev)",
  "short_name": "ChampMail",
  "version": "0.1.0",
  "description": "Syncs your LinkedIn session with ChampMail so you can automate your own engagement without sharing a password.",
  "key": "",
  "permissions": ["cookies", "storage", "alarms", "notifications"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChampMail Connector",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  }
}
