# =============================================================================
# B2B Pulse — VPS backend configuration
#
#   cp .env.vps.example .env  &&  $EDITOR .env
#
# Every value marked REQUIRED must be set before the stack will start. Values
# marked SECRET must be generated fresh for this deployment — never copied from
# a tutorial, another environment, or this file.
#
# This file is the template and belongs in git. `.env` is the real thing and
# must not be. Check `git status` before your first commit on a new box.
# =============================================================================

# ---------- Where this deployment lives -------------------------------------

# REQUIRED. The API's own domain, pointed at this VPS with an A record. Caddy
# obtains a certificate for exactly this name, so it must resolve here before
# you start the stack or issuance fails.
API_DOMAIN=api.example.com

# REQUIRED. Where the frontend is served from — the browser origin, not the
# API's. This is the CORS allow-list, so the SPA cannot talk to the API until
# it is right, and a trailing slash will break it. Comma-separate for several
# (e.g. a preview domain alongside production).
CORS_ORIGINS=https://app.example.com

APP_NAME=B2B Pulse
APP_ENV=production

# ---------- Database ---------------------------------------------------------
# The compose file builds DATABASE_URL from these; do not set it directly.
# SECRET: generate with `openssl rand -base64 32 | tr -d '/+='`
POSTGRES_USER=b2bpulse
POSTGRES_PASSWORD=
POSTGRES_DB=b2bpulse

# ---------- Secrets ----------------------------------------------------------

# SECRET. Signs internal tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SECRET, AND THE MOST IMPORTANT VALUE IN THIS FILE.
#
# This encrypts every connected LinkedIn session credential at rest. Two
# consequences worth internalising before you generate it:
#
#   * Lose it and every connected account must be reconnected by hand. There
#     is no recovery path — that is the point of encryption at rest.
#   * Leak it and anyone with a copy of the database can decrypt and use your
#     team's LinkedIn sessions.
#
# Back it up somewhere that is not this server (a password manager), and keep
# it out of shell history:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------- Clerk (who may log in) -------------------------------------------
# From the Clerk dashboard: API Keys, then Show JWT public key / Frontend API.
CLERK_JWKS_URL=https://<subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<subdomain>.clerk.accounts.dev
CLERK_AUDIENCE=

# Accepts unsigned tokens. Local development only — setting this in production
# means anyone who can reach the API can mint themselves an admin session.
CLERK_DEV_UNSAFE=false

# ---------- OpenRouter (comment and message copy) ----------------------------
# https://openrouter.ai/ → Keys. Without it the product still runs, but
# generated copy falls back to templates and reads like it.
OPENROUTER_API_KEY=
# The writer. Copy quality is what keeps acceptance above the 15% line that
# LinkedIn treats as spam, so this is not the place to economise.
OPENROUTER_GENERATION_MODEL=anthropic/claude-sonnet-4-5-20250929
# The second-pass reviewer that catches generic openers before a human sees
# them. Cheap and fast is the right trade here.
OPENROUTER_REVIEW_MODEL=anthropic/claude-haiku-4-5-20251001

# ---------- LinkedIn OAuth (optional) ----------------------------------------
# Only needed for the official-API engagement path. Account connection via
# session cookies does not use it.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.example.com/api/integrations/linkedin/callback
LINKEDIN_AUTH_REDIRECT_URI=https://api.example.com/api/auth/linkedin/callback

# ---------- Transport --------------------------------------------------------
# Voyager first, headless Chromium as the automatic fallback. Set false to pin
# to the browser path if a Voyager change starts causing trouble — throughput
# drops, nothing breaks.
MOBILE_TRANSPORT_ENABLED=true

# Residential proxy for outbound LinkedIn traffic, as
# protocol://user:pass@host:port. Optional, and worth understanding before you
# decide: LinkedIn ties account trust partly to a consistent origin, so a
# datacentre IP shared by many accounts is worse than no proxy at all, and a
# proxy that rotates per request is worse still. Leave empty unless you have a
# residential or mobile endpoint that is stable per account.
BROWSER_PROXY_URL=

# ---------- Safety -----------------------------------------------------------
# Emergency escape hatch: lets actions proceed when the rate limiter cannot be
# reached. Leave false. Setting it true means a Redis outage silently removes
# every cap, which is the exact scenario the caps exist for.
ALLOW_UNCAPPED_SENDING=false

# ---------- Observability (optional) -----------------------------------------
SENTRY_DSN=
